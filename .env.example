# --- Gemini (required for visual OCR; deterministic text extraction works without it) ---
GEMINI_API_KEY=
# Primary extraction model. Verify current IDs at https://ai.google.dev/gemini-api/docs/models
GEMINI_MODEL=gemini-3.8-flash
# Used only for targeted second-pass review of flagged regions.
GEMINI_REVIEW_MODEL=gemini-3.8-flash
# Optional: model for math-heavy pages (defaults to GEMINI_MODEL).
GEMINI_MATH_MODEL=
# Request timeout (seconds), max retries, requests-per-minute cap, page concurrency.
GEMINI_TIMEOUT_SECONDS=180
GEMINI_MAX_RETRIES=4
GEMINI_RPM_LIMIT=30
SCHOLAROCR_CONCURRENCY=2

# --- Storage ---
# Where documents, IR, artifacts and the SQLite DB live. Windows example: C:\Users\you\ScholarOCR
SCHOLAROCR_DATA_DIR=
SCHOLAROCR_LOG_LEVEL=INFO

# --- Security: directories the engine may read source files from (os.pathsep-separated:
# ';' on Windows, ':' on Linux/macOS). Default: the current working directory only.
SCHOLAROCR_ALLOWED_DIRS=
SCHOLAROCR_MAX_FILE_MB=200
SCHOLAROCR_MAX_PAGES=1000

# --- Processing ---
SCHOLAROCR_RENDER_DPI=200
# Pages at or below this count are processed synchronously by MCP ocr_document.
SCHOLAROCR_SYNC_PAGE_LIMIT=4
# Optional JSON file with per-model token prices for cost estimates (no prices are hardcoded).
SCHOLAROCR_PRICING_FILE=
# Optional retention: delete generated artifacts (never preserved sources) of documents idle N days.
SCHOLAROCR_RETENTION_DAYS=
# Optional TTF font for searchable-PDF text layers (auto-discovered if unset).
SCHOLAROCR_TEXT_LAYER_FONT=

# --- Provider: "gemini" (default) or "openrouter" (OpenAI-compatible, image input required) ---
# SCHOLAROCR_PROVIDER=openrouter
# Falls back to the OPENROUTER_API_KEY environment variable when unset here.
# OPENROUTER_API_KEY=
# Model ids replace GEMINI_* when the provider is openrouter. Default: nvidia/nemotron-3.5-super-vl:free
# OPENROUTER_MODEL=nvidia/nemotron-3.5-super-vl:free
# Review and math models default to OPENROUTER_MODEL.
# OPENROUTER_REVIEW_MODEL=
# OPENROUTER_MATH_MODEL=
# Output cap per call (reasoning included) and reasoning effort (none|minimal|low|medium|high).
# OPENROUTER_MAX_TOKENS=16384
# OPENROUTER_REASONING_EFFORT=low
