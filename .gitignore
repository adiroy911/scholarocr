# Environments
.venv/
venv/
env/

# Secrets: never commit. .env.example is the template.
.env
.env.*
!.env.example
*.pem
*.key

# Python build and cache output
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/
dist/
build/

# Runtime data (documents, artifacts, sqlite, logs). SCHOLAROCR_DATA_DIR defaults to
# %LOCALAPPDATA%\ScholarOCR or ~/.local/share/scholarocr, outside the repo; these cover local overrides.
data/
scholarocr-data/
ScholarOCR-data/
*.db
*.sqlite
*.sqlite3
*.db-journal
*.db-wal
*.db-shm
*.log
logs/
out/
outputs/

# Benchmark run results (generated by benchmarks/run_benchmark.py)
benchmarks/results/*
!benchmarks/results/.gitkeep

# Gemini extension release archives (scripts/build_gemini_extension_archive.py)
dist-extension/

# Editors and OS
.vscode/
.idea/
.DS_Store
Thumbs.db
